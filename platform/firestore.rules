rules_version = '2';

// Cold Run Readiness – Karbala Cement Plant.
// The Spark (free) plan has no Cloud Functions, so every permission and workflow guard lives here.
// Roles: admin, manager (Cold Run Test Manager), member (team member with a discipline and department).
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() { return request.auth != null; }
    function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function me() { return get(userPath(request.auth.uid)).data; }
    function active() { return signedIn() && exists(userPath(request.auth.uid)) && me().active == true; }
    function role() { return me().role; }
    function hasRole(roles) { return active() && role() in roles; }
    function staff() { return active(); }
    function leads() { return ['manager', 'admin']; }
    function roles() { return ['admin', 'manager', 'member']; }
    function disciplines() { return ['mechanical', 'electrical', 'instrumentation', 'production']; }
    function setupPath() { return /databases/$(database)/documents/config/setup; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function unchanged(keys) { return !changed().hasAny(keys); }

    // ---------- bootstrap & configuration ----------
    match /config/setup {
      allow read: if true;
      allow create: if signedIn() && !exists(setupPath())
        && request.resource.data.adminUid == request.auth.uid
        && getAfter(userPath(request.auth.uid)).data.role == 'admin';
      allow update, delete: if false;
    }
    match /config/settings {
      allow read: if active();
      allow write: if hasRole(['admin']);
    }
    // The current yearly shutdown.
    match /config/shutdown {
      allow read: if active();
      allow write: if hasRole(leads()) && request.resource.data.currentId is string
        && existsAfter(/databases/$(database)/documents/shutdowns/$(request.resource.data.currentId));
    }
    match /shutdowns/{id} {
      allow read: if active();
      allow create: if hasRole(leads()) && request.resource.data.status == 'open';
      allow update: if hasRole(leads()) && resource.data.status == 'open' && request.resource.data.status == 'closed'
        && request.resource.data.closedBy == request.auth.uid
        && changed().hasOnly(['status', 'closedAt', 'closedBy', 'closedByName', 'archived']);
      allow delete: if false;
    }

    // ---------- users & devices ----------
    function validProfile(d) {
      return d.role in roles() && (d.role != 'member' || d.discipline in disciplines());
    }
    match /users/{uid} {
      allow read: if signedIn() && (uid == request.auth.uid || active());
      allow create: if (hasRole(['admin']) && validProfile(request.resource.data))
        || (uid == request.auth.uid && !exists(setupPath())
            && getAfter(setupPath()).data.adminUid == request.auth.uid
            && request.resource.data.role == 'admin' && request.resource.data.active == true)
        || claimsInvite(uid);
      // Someone the administrator invited by email claims it on first sign-in (Google or password).
      // The profile must copy the invitation exactly and the invitation is consumed in the same write.
      function claimsInvite(uid) {
        let inv = invitePath(myEmail());
        let i = get(inv).data;
        let d = request.resource.data;
        return uid == request.auth.uid && verifiedEmail() && exists(inv) && !existsAfter(inv)
          && d.keys().hasOnly(['name', 'email', 'role', 'discipline', 'departmentId', 'phone', 'active', 'lang', 'createdAt', 'createdBy'])
          && d.email.lower() == myEmail() && d.role == i.role && d.discipline == i.discipline && d.departmentId == i.departmentId
          && d.active == true && d.createdBy == i.invitedBy && d.createdAt == request.time;
      }
      allow update: if (hasRole(['admin']) && validProfile(request.resource.data))
        || (uid == request.auth.uid && active() && changed().hasOnly(['lang', 'phone', 'name']));
      allow delete: if false;
    }

    function invitePath(email) { return /databases/$(database)/documents/invites/$(email); }
    function verifiedEmail() { return signedIn() && request.auth.token.email != null && request.auth.token.email_verified == true; }
    function myEmail() { return request.auth.token.email.lower(); }

    match /invites/{email} {
      allow read: if hasRole(['admin']) || (verifiedEmail() && myEmail() == email);
      allow create, update: if hasRole(['admin'])
        && request.resource.data.keys().hasOnly(['email', 'name', 'role', 'discipline', 'departmentId', 'phone', 'invitedBy', 'createdAt'])
        && request.resource.data.email == email && email.lower() == email
        && validProfile(request.resource.data)
        && request.resource.data.invitedBy == request.auth.uid;
      allow delete: if hasRole(['admin'])
        || (verifiedEmail() && myEmail() == email && existsAfter(userPath(request.auth.uid)));
    }

    match /devices/{id} {
      function own() { return signedIn() && id.matches(request.auth.uid + '_.*'); }
      allow read: if own() || hasRole(['admin']);
      allow create: if own() && request.resource.data.uid == request.auth.uid && request.resource.data.revoked == false;
      allow update: if hasRole(['admin'])
        || (own() && request.resource.data.uid == resource.data.uid && unchanged(['revoked', 'revokedBy']));
      allow delete: if hasRole(['admin']);
    }

    // ---------- master data ----------
    match /departments/{id} { allow read: if active(); allow write: if hasRole(['admin']); }
    match /equipment/{id} {
      allow read: if active();
      allow create, update: if hasRole(leads())
        && request.resource.data.keys().hasOnly(['name', 'departmentId', 'parts', 'active', 'updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 200
        && exists(/databases/$(database)/documents/departments/$(request.resource.data.departmentId))
        && request.resource.data.parts is map && request.resource.data.parts.keys().hasOnly(disciplines())
        && request.resource.data.active is bool;
      allow delete: if false;
    }

    // ---------- inspections ----------
    // One per equipment + discipline + shutdown (the id says so). Team members work on their own
    // discipline and department; only the Cold Run Test Manager or an administrator approves and archives.
    match /inspections/{id} {
      function d() { return request.resource.data; }
      function team(x) {
        return hasRole(leads()) || (role() == 'member' && me().discipline == x.discipline
          && (me().departmentId == null || me().departmentId == x.departmentId));
      }
      function equipment() { return get(/databases/$(database)/documents/equipment/$(d().equipmentId)).data; }
      function work() {
        return resource.data.status in ['pool', 'corrective'] && team(resource.data)
          && d().status in ['pool', 'corrective', 'waiting_approval']
          && unchanged(['approval', 'archivedAt'])
          && (d().status == 'pool' || d().summary.pending == 0)
          && (d().status != 'waiting_approval' || d().summary.notok == d().summary.fixed);
      }
      function approve() {
        return hasRole(leads()) && resource.data.status == 'waiting_approval' && d().status == 'approved'
          && d().approval.by == request.auth.uid && changed().hasOnly(['status', 'approval', 'updatedAt', 'docVersion']);
      }
      function sendBack() {
        return hasRole(leads()) && resource.data.status in ['waiting_approval', 'approved'] && d().status == 'pool'
          && d().rejection.by == request.auth.uid && d().rejection.reason.size() >= 3
          && changed().hasOnly(['status', 'approval', 'rejection', 'updatedAt', 'docVersion']);
      }
      function archive() {
        return hasRole(leads()) && resource.data.status == 'approved' && d().status == 'archived'
          && changed().hasOnly(['status', 'archivedAt', 'updatedAt', 'docVersion']);
      }

      allow read: if active();
      allow create: if active() && team(d())
        && id == d().shutdownId + '_' + d().equipmentId + '_' + d().discipline
        && d().shutdownId == get(/databases/$(database)/documents/config/shutdown).data.currentId
        && equipment().departmentId == d().departmentId && equipment().name == d().title
        && d().discipline in disciplines()
        && d().status == 'pool' && d().docVersion == 1 && d().createdBy == request.auth.uid
        && d().approval == null && d().results.size() == 0;
      allow update: if active() && d().docVersion == resource.data.docVersion + 1
        && unchanged(['code', 'shutdownId', 'shutdownName', 'title', 'equipmentId', 'departmentId', 'discipline', 'parts', 'createdBy', 'createdByName', 'createdAt'])
        && (work() || approve() || sendBack() || archive());
      allow delete: if hasRole(['admin']) && resource.data.status == 'pool';
    }

    match /documents/{id} {
      allow read: if hasRole(['admin']) || (active() && resource.data.visibleTo.hasAny(['all', role()]));
      allow create, update: if hasRole(leads());
      allow delete: if hasRole(['admin']);
    }

    match /counters/{id} {
      allow read: if staff();
      allow write: if staff() && request.resource.data.value ==
        (resource == null ? 1 : resource.data.value + 1);
    }

    // ---------- files (stored in Firestore on the free plan) ----------
    match /attachments/{id} {
      allow read: if active();
      allow create: if staff()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.data is string
        && request.resource.data.data.size() < 950000;
      allow update: if false;
      allow delete: if hasRole(['admin']) || (staff() && resource.data.createdBy == request.auth.uid);
    }

    // ---------- notifications & audit ----------
    match /notifications/{id} {
      allow read: if signedIn() && resource.data.toUid == request.auth.uid;
      // Only well-formed, unread, server-timestamped messages to a real user with an in-app link.
      allow create: if staff()
        && request.resource.data.keys().hasOnly(['toUid', 'title', 'link', 'read', 'createdAt'])
        && request.resource.data.toUid is string && exists(userPath(request.resource.data.toUid))
        && request.resource.data.title is map && request.resource.data.title.keys().hasOnly(['en', 'ar'])
        && request.resource.data.title.en is string && request.resource.data.title.en.size() <= 300
        && request.resource.data.title.ar is string && request.resource.data.title.ar.size() <= 300
        && request.resource.data.link is string && request.resource.data.link.matches('/[^/].{0,199}|/')
        && request.resource.data.read == false
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && resource.data.toUid == request.auth.uid && changed().hasOnly(['read'])
        && request.resource.data.read is bool;
      allow delete: if signedIn() && resource.data.toUid == request.auth.uid;
    }

    match /audit/{id} {
      allow read: if hasRole(['admin', 'manager']);
      allow create: if active() && request.resource.data.uid == request.auth.uid
        && request.resource.data.at == request.time;
      allow update, delete: if false;
    }
  }
}
