{
  "name": "kcp-coldrun-platform",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "emulators": "firebase emulators:start --only auth,firestore,hosting",
    "test:rules": "firebase emulators:exec --only firestore \"node --test tests/rules.test.mjs\"",
    "deploy": "npm run build && firebase deploy --only hosting,firestore",
    "firebase:setup": "node scripts/setup-firebase.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "firebase": "^12.19.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "firebase-tools": "^13.25.0",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.0"
  }
}
